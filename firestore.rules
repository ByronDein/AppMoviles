rules_version = '2';

// Reglas de seguridad de Cloud Firestore para ConectaSeñas.
// Cada usuario solo puede leer y escribir lo que está dentro de su propio documento
// (usuarios/{uid}) y de sus subcolecciones (mensajes, dispositivos).
// Se pegan en Firebase Console > Firestore Database > Reglas > Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /mensajes/{mensajeId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /dispositivos/{dispositivoId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Todo lo demás está bloqueado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
